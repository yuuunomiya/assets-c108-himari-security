# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Environment files
/.env
/.env.*.local

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
# 親ディレクトリが除外されていると配下のファイルを再包含できないため、
# .keep を残したいディレクトリ自体を先に除外から外しておく。
!/tmp/pids/
!/tmp/storage/

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore Kamal files.
/config/deploy*.yml
/.kamal
