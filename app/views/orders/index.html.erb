<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">注文履歴</h1>

  <% if @orders.any? %>
    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
      <table class="w-full">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50">
            <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">注文番号</th>
            <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">注文日時</th>
            <th class="text-right px-6 py-4 text-sm font-semibold text-gray-600">合計</th>
            <th class="text-center px-6 py-4 text-sm font-semibold text-gray-600">ステータス</th>
            <th class="px-6 py-4"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @orders.each do |order| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">#<%= order.id %></td>
              <td class="px-6 py-4 text-sm text-gray-600"><%= l order.created_at, format: :long %></td>
              <td class="px-6 py-4 text-right font-semibold text-gray-900">
                ¥<%= number_with_delimiter(order.total_price) %>
              </td>
              <td class="px-6 py-4 text-center">
                <% status_classes = case order.status
                   when "completed" then "bg-green-100 text-green-700"
                   when "cancelled" then "bg-red-100 text-red-700"
                   else "bg-yellow-100 text-yellow-700"
                   end %>
                <span class="<%= status_classes %> px-3 py-1 rounded-full text-xs font-medium">
                  <%= order.status_label %>
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                <%= link_to "詳細", order_path(order), class: "text-blue-600 hover:underline text-sm font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white rounded-2xl border border-gray-200">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-200 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <p class="text-gray-500 mb-4">まだ注文履歴がありません</p>
      <%= link_to "商品を探す", products_path, class: "text-blue-600 hover:underline font-medium" %>
    </div>
  <% end %>
</div>
