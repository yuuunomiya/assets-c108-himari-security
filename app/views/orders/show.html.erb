<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">注文詳細</h1>
    <%= link_to "注文履歴に戻る", orders_path, class: "text-blue-600 hover:underline text-sm" %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
      <div>
        <p class="text-sm text-gray-500">注文番号</p>
        <p class="font-bold text-gray-900">#<%= @order.id %></p>
      </div>
      <div class="text-right">
        <p class="text-sm text-gray-500">注文日時</p>
        <p class="text-sm text-gray-700"><%= l @order.created_at, format: :long %></p>
      </div>
      <div>
        <% status_classes = case @order.status
           when "completed" then "bg-green-100 text-green-700"
           when "cancelled" then "bg-red-100 text-red-700"
           else "bg-yellow-100 text-yellow-700"
           end %>
        <span class="<%= status_classes %> px-3 py-1 rounded-full text-sm font-medium">
          <%= @order.status_label %>
        </span>
      </div>
    </div>

    <table class="w-full">
      <thead>
        <tr class="border-b border-gray-100">
          <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500">商品</th>
          <th class="text-right px-6 py-3 text-xs font-semibold text-gray-500">単価</th>
          <th class="text-center px-6 py-3 text-xs font-semibold text-gray-500">数量</th>
          <th class="text-right px-6 py-3 text-xs font-semibold text-gray-500">小計</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @order.order_items.includes(:product).each do |item| %>
          <tr>
            <td class="px-6 py-4">
              <p class="text-sm font-medium text-gray-900"><%= item.product_name.presence || item.product&.name || "（削除済み商品）" %></p>
              <p class="text-xs text-slate-500"><%= item.product&.category_label %></p>
            </td>
            <td class="px-6 py-4 text-right text-sm text-gray-700">
              ¥<%= number_with_delimiter(item.unit_price) %>
            </td>
            <td class="px-6 py-4 text-center text-sm text-gray-700">
              <%= item.quantity %>
            </td>
            <td class="px-6 py-4 text-right text-sm font-semibold text-gray-900">
              ¥<%= number_with_delimiter(item.subtotal) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <div class="flex justify-between items-center">
        <span class="font-bold text-gray-900">合計金額</span>
        <span class="text-xl font-bold text-gray-900">¥<%= number_with_delimiter(@order.total_price) %></span>
      </div>
    </div>
  </div>
</div>
