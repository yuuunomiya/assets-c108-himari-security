<%= form_with model: [:admin, product], class: "space-y-6" do |f| %>
  <% if product.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <p class="text-red-700 font-medium mb-2">入力エラーがあります：</p>
      <ul class="list-disc list-inside text-red-600 text-sm space-y-1">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="md:col-span-2">
      <%= f.label :name, "商品名", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :category, "カテゴリ", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :category,
          options_for_select(Product::CATEGORY_LABELS.map { |k, v| [v, k] }, product.category),
          { include_blank: "選択してください" },
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" %>
    </div>

    <div>
      <%= f.label :price, "価格（円）", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :price, min: 1, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :stock, "在庫数", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :stock, min: 0, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :image_url, "画像URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.url_field :image_url, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "https://..." %>
    </div>

    <div class="md:col-span-2">
      <%= f.label :description, "商品説明", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="flex items-center space-x-3">
      <%= f.check_box :featured, class: "h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
      <%= f.label :featured, "おすすめ商品として表示", class: "text-sm font-medium text-gray-700" %>
    </div>

    <div class="flex items-center space-x-3">
      <%= f.check_box :discontinued, class: "h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
      <%= f.label :discontinued, "販売停止中（一覧・詳細ページで非公開）", class: "text-sm font-medium text-gray-700" %>
    </div>
  </div>

  <div class="flex space-x-4 pt-4 border-t border-gray-200">
    <%= f.submit product.new_record? ? "登録する" : "更新する",
        class: "bg-blue-600 text-white font-bold px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
    <%= link_to "キャンセル", admin_products_path,
        class: "border border-gray-300 text-gray-700 font-bold px-6 py-2 rounded-lg hover:bg-gray-50 transition-colors" %>
  </div>
<% end %>
