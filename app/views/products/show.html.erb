<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- パンくず -->
  <nav class="text-sm text-gray-500 mb-6">
    <%= link_to "ホーム", root_path, class: "hover:text-blue-600" %> &rsaquo;
    <%= link_to "商品一覧", products_path, class: "hover:text-blue-600" %> &rsaquo;
    <span class="text-gray-900"><%= @product.name %></span>
  </nav>

  <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
      <!-- 商品画像 -->
      <div class="bg-gray-50 flex items-center justify-center p-8 min-h-64">
        <% if @product.image_url.present? %>
          <img src="<%= @product.image_url %>" alt="<%= @product.name %>"
               class="max-w-full max-h-80 object-contain rounded-lg">
        <% else %>
          <div class="text-gray-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        <% end %>
      </div>

      <!-- 商品情報 -->
      <div class="p-8">
        <span class="text-sm text-slate-600 font-medium bg-slate-100 px-3 py-1 rounded-full">
          <%= @product.category_label %>
        </span>

        <h1 class="text-2xl font-bold text-gray-900 mt-4 mb-2"><%= @product.name %></h1>

        <div class="text-4xl font-bold text-gray-900 mb-4">
          ¥<%= number_with_delimiter(@product.price) %>
          <span class="text-base font-normal text-gray-500">（税込）</span>
        </div>

        <% if @product.in_stock? %>
          <div class="flex items-center space-x-2 mb-6">
            <span class="w-2 h-2 bg-green-400 rounded-full"></span>
            <span class="text-sm text-green-600 font-medium">在庫あり（残り <%= @product.stock %> 点）</span>
          </div>
        <% else %>
          <div class="flex items-center space-x-2 mb-6">
            <span class="w-2 h-2 bg-red-400 rounded-full"></span>
            <span class="text-sm text-red-600 font-medium">在庫切れ</span>
          </div>
        <% end %>

        <% if @product.in_stock? %>
          <%= form_with url: add_to_cart_path(product_id: @product.id), method: :post do |f| %>
            <div class="flex items-center space-x-3 mb-4">
              <label class="text-sm text-gray-600 font-medium">数量:</label>
              <%= f.number_field :quantity, value: 1, min: 1, max: @product.stock,
                  class: "w-20 border border-gray-300 rounded-lg px-3 py-2 text-center focus:outline-none focus:ring-2 focus:ring-blue-500" %>
            </div>
            <%= f.submit "カートに追加", class: "w-full bg-amber-500 text-white font-bold py-4 px-6 rounded-xl hover:bg-amber-600 transition-colors cursor-pointer text-lg shadow-md" %>
          <% end %>
        <% else %>
          <button disabled class="w-full bg-gray-200 text-gray-500 font-bold py-3 px-6 rounded-xl cursor-not-allowed text-lg">
            在庫切れ
          </button>
        <% end %>
      </div>
    </div>

    <!-- 商品説明 -->
    <div class="border-t border-gray-200 p-8">
      <h2 class="text-lg font-bold text-gray-900 mb-4">商品説明</h2>
      <div class="text-gray-700 leading-relaxed whitespace-pre-line">
        <%# 脆弱性を含まないバージョン（安全・参考用） %>
        <% if false %>
          <%= @product.description %>
        <% end %>

        <%# 第5章: XSS: 商品説明をHTMLタグで装飾して表示したいという理由でrawを使っているが、
            利用者に由来する値（description）に対してrawを使うと、
            <script>タグなどがそのまま実行されてしまう（格納型XSS） %>
        <%= raw @product.description %>
      </div>
    </div>
  </div>
</div>
