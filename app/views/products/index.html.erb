<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">商品一覧</h1>

  <!-- 検索フォーム -->
  <%= form_with url: products_path, method: :get, class: "mb-6" do |f| %>
    <div class="flex flex-col sm:flex-row gap-3">
      <div class="flex-1">
        <%= f.text_field :query, value: params[:query], placeholder: "商品名・説明で検索...",
            class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>
      <div>
        <%= f.select :category,
            options_for_select([["すべてのカテゴリ", ""]] + Product::CATEGORY_LABELS.map { |k, v| [v, k] }, params[:category]),
            {},
            class: "border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white" %>
      </div>
      <%= f.submit "検索", class: "bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors font-medium cursor-pointer" %>
      <% if params[:query].present? || params[:category].present? %>
        <%= link_to "クリア", products_path, class: "text-gray-500 hover:text-gray-700 px-4 py-2 border border-gray-300 rounded-lg transition-colors" %>
      <% end %>
    </div>
  <% end %>

  <!-- 検索結果表示 -->
  <% if false # 脆弱性を含まないバージョン（安全・参考用） %>
    <% if params[:query].present? || params[:category].present? %>
      <p class="text-sm text-gray-500 mb-4">
        <% parts = [] %>
        <% parts << "「#{params[:query]}」" if params[:query].present? %>
        <% parts << Product::CATEGORY_LABELS[params[:category]] if params[:category].present? %>
        <%= parts.join(" / ") %>の検索結果: <%= @products.count %>件
      </p>
    <% end %>
  <% end %>

  <%# 第5章: XSS: 見出しの生成はsearch_result_heading（app/helpers/products_helper.rb）に
      委譲している。同メソッドがhtml_safeを使っていると、params[:query]に含まれる
      スクリプトがそのまま実行されてしまう（反射型XSS） %>
  <% if params[:query].present? || params[:category].present? %>
    <p class="text-sm text-gray-500 mb-4">
      <%= search_result_heading(params[:query], params[:category]) %>: <%= @products.count %>件
    </p>
  <% end %>

  <!-- 商品グリッド -->
  <% if @products.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5">
      <% @products.each do |product| %>
        <%= render "product_card", product: product %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <p class="text-gray-500">該当する商品が見つかりませんでした。</p>
      <%= link_to "すべての商品を見る", products_path, class: "text-blue-600 hover:underline mt-2 inline-block" %>
    </div>
  <% end %>
</div>
