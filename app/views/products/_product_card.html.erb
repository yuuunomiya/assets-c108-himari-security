<div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow group">
  <%= link_to product_path(product), class: "block" do %>
    <div class="aspect-square bg-gray-50 overflow-hidden">
      <% if product.image_url.present? %>
        <img src="<%= product.image_url %>" alt="<%= product.name %>"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200">
      <% else %>
        <div class="w-full h-full flex items-center justify-center text-gray-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      <% end %>
    </div>
    <div class="p-4">
      <span class="text-xs text-slate-600 font-medium bg-slate-100 px-2 py-0.5 rounded-full">
        <%= product.category_label %>
      </span>
      <h3 class="text-sm font-medium text-gray-900 mt-2 line-clamp-2 group-hover:text-blue-600">
        <%= product.name %>
      </h3>
      <p class="text-lg font-bold text-gray-900 mt-1">
        ¥<%= number_with_delimiter(product.price) %>
        <span class="text-xs font-normal text-gray-500">（税込）</span>
      </p>
      <% unless product.in_stock? %>
        <span class="text-xs text-red-500 font-medium">在庫切れ</span>
      <% end %>
    </div>
  <% end %>
</div>
