<nav class="bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- ロゴ -->
      <div class="flex items-center space-x-8">
        <%= link_to root_path, class: "flex items-center space-x-2" do %>
          <div class="w-8 h-8 bg-blue-600 rounded flex items-center justify-center">
            <span class="text-white font-bold text-sm">M</span>
          </div>
          <span class="font-bold text-gray-900 text-lg hidden sm:block">ミレニアム電子部品</span>
        <% end %>

        <%= link_to "商品一覧", products_path, class: "text-gray-600 hover:text-blue-600 font-medium transition-colors" %>
      </div>

      <!-- 右メニュー -->
      <div class="flex items-center space-x-4">
        <!-- カートアイコン -->
        <%= link_to cart_path, class: "relative text-gray-600 hover:text-blue-600 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-1.5 6M17 13l1.5 6M9 19a1 1 0 100 2 1 1 0 000-2zm8 0a1 1 0 100 2 1 1 0 000-2z" />
          </svg>
          <% if cart_item_count > 0 %>
            <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center font-bold">
              <%= cart_item_count %>
            </span>
          <% end %>
        <% end %>

        <!-- ユーザーメニュー -->
        <% if user_signed_in? %>
          <div class="flex items-center space-x-3">
            <% if current_user.admin? %>
              <%= link_to "管理者", admin_products_path, class: "text-sm bg-orange-100 text-orange-700 px-3 py-1 rounded-full hover:bg-orange-200 transition-colors font-medium" %>
            <% end %>
            <%= link_to "注文履歴", orders_path, class: "text-gray-600 hover:text-blue-600 text-sm font-medium transition-colors" %>
            <%= link_to "アカウント設定", profile_path, class: "text-gray-600 hover:text-blue-600 text-sm font-medium transition-colors" %>
            <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-gray-600 hover:text-red-600 text-sm font-medium transition-colors" %>
          </div>
        <% else %>
          <div class="flex items-center space-x-3">
            <%= link_to "ログイン", new_user_session_path, class: "text-gray-600 hover:text-blue-600 text-sm font-medium transition-colors" %>
            <%= link_to "新規登録", new_user_registration_path, class: "bg-blue-600 text-white text-sm px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors font-medium" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</nav>
