<!-- ヒーローバナー -->
<section class="bg-gradient-to-r from-blue-700 to-blue-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="max-w-2xl">
      <h1 class="text-3xl md:text-5xl font-bold mb-4 leading-tight">
        電子部品の通販なら<br>ミレニアム電子部品
      </h1>
      <p class="text-blue-200 text-lg mb-8">
        コンデンサ・抵抗・半導体など、豊富な電子部品を取り揃えています。<br>
        個人から企業まで、幅広いニーズにお応えします。
      </p>
      <%= link_to "商品一覧を見る", products_path, class: "inline-block bg-white text-blue-700 font-bold px-8 py-3 rounded-lg hover:bg-blue-50 transition-colors text-lg" %>
    </div>
  </div>
</section>

<!-- おすすめ商品 -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900">おすすめ商品</h2>
  </div>

  <% if @featured_products.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% @featured_products.each do |product| %>
        <%= render "products/product_card", product: product %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">現在おすすめ商品はありません。</p>
  <% end %>
</section>

<!-- カテゴリ案内 -->
<section class="bg-gray-100 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">カテゴリから探す</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      <% Product::CATEGORY_LABELS.each do |key, label| %>
        <%= link_to products_path(category: key), class: "bg-white rounded-xl p-4 text-center hover:shadow-md hover:border-blue-200 border border-transparent transition-all group" do %>
          <div class="text-3xl mb-2">
            <% case key
               when "capacitor" then %><span>⚡</span><%
               when "resistor"  then %><span>〰️</span><%
               when "semiconductor" then %><span>🔬</span><%
               when "connector" then %><span>🔌</span><%
               when "inductor"  then %><span>🌀</span><%
               else %><span>🔧</span><% end %>
          </div>
          <span class="text-sm font-medium text-gray-700 group-hover:text-blue-600"><%= label %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
